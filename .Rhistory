tou_prices <- ts %>% dplyr::left_join(tou_prices) %>% dplyr::arrange(tariff,yeartime) %>% dplyr::group_by(tariff) %>% dplyr::mutate(price = zoo::na.approx(price, rule = 2))
tou_prices$tariff_plan <- "tou"
