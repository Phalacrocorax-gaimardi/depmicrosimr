costs <- get_prospect_costs_light(8760, 0.25, 1, 0.2, 48, "LP1", 2025, prices_scen,params)
get_ce_value(sD,costs$flat, costs$tou_noflex, costs$tou_flex, costs$det_noflex, costs$det_flex)
